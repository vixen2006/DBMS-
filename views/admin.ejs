<%- include('header') %>
<main class="main-content">
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Admin Dashboard</h1>
        <div>
            <a href="/admin/add-song" class="btn btn-success me-2"><i class="bi bi-plus-lg me-1"></i> Add Song</a>
            <a href="/admin/add-singer" class="btn btn-outline-primary me-2"><i class="bi bi-person-plus me-1"></i> Add Singer</a>
            <a href="/admin/add-composer" class="btn btn-outline-info"><i class="bi bi-person-plus me-1"></i> Add Composer</a>
        </div>
    </div>
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
        <div class="col"><div class="stat-card"><div class="stat-val"><%= stats.songs %></div><div class="stat-lbl">Songs</div></div></div>
        <div class="col"><div class="stat-card"><div class="stat-val"><%= stats.singers %></div><div class="stat-lbl">Singers</div></div></div>
        <div class="col"><div class="stat-card"><div class="stat-val"><%= stats.customers %></div><div class="stat-lbl">Customers</div></div></div>
        <div class="col"><div class="stat-card"><div class="stat-val">₹<%= stats.revenue %></div><div class="stat-lbl">Revenue</div></div></div>
    </div>
    <div class="admin-card">
        <h5 class="fw-bold mb-3">Recent Purchases</h5>
        <table class="table">
            <thead><tr><th>#</th><th>Customer</th><th>Song</th><th>Amount</th></tr></thead>
            <tbody>
            <% recent.forEach(function(r) { %>
                <tr><td><%= r.purchase_id %></td><td><%= r.username %></td><td><%= r.song_title %></td><td>₹<%= r.amount_paid %></td></tr>
            <% }); %>
            </tbody>
        </table>
    <div class="admin-card mt-4">
        <ul class="nav nav-tabs mb-3" id="adminTabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-singers">Singers</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-composers">Composers</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-companies">Companies</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-customers">Customers</button></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-singers">
                <table class="table">
                    <thead><tr><th>Name</th><th>Phone</th><th>Address</th></tr></thead>
                    <tbody><% allData.singers.forEach(s => { %> <tr><td><%= s.name %></td><td><%= s.contact_no %></td><td><%= s.address %></td></tr> <% }); %></tbody>
                </table>
            </div>
            <div class="tab-pane fade" id="tab-composers">
                <table class="table">
                    <thead><tr><th>Name</th><th>Phone</th><th>Address</th></tr></thead>
                    <tbody><% allData.composers.forEach(c => { %> <tr><td><%= c.name %></td><td><%= c.contact_no %></td><td><%= c.address %></td></tr> <% }); %></tbody>
                </table>
            </div>
            <div class="tab-pane fade" id="tab-companies">
                <table class="table">
                    <thead><tr><th>Company Name</th></tr></thead>
                    <tbody><% allData.companies.forEach(c => { %> <tr><td><%= c.name %></td></tr> <% }); %></tbody>
                </table>
            </div>
            <div class="tab-pane fade" id="tab-customers">
                <table class="table">
                    <thead><tr><th>ID/Username</th><th>Role</th></tr></thead>
                    <tbody><% allData.customers.forEach(u => { %> <tr><td><%= u.username %></td><td><%= u.role %></td></tr> <% }); %></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</main>
<%- include('footer') %>
